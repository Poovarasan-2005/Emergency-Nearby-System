rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'ADMIN' ||
        request.auth.token.role == 'SUPER_ADMIN'
      );
    }

    // 1. User Profiles & Confidential Medical Data
    // Stored strictly by user ID; only the owner can read or edit their medical notes.
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Admins CANNOT read private medical profile records; privacy is strictly preserved.
    }

    // 2. Trusted Contacts
    // Sub-collection under user profile. Only the owner can manage contacts.
    match /users/{userId}/trustedContacts/{contactId} {
      allow read, write: if isOwner(userId);
    }

    // 3. Emergency Sessions
    // Users can create and update their own emergency sessions.
    // Admins can read emergency telemetry (coords, category, timestamp) for active incident dispatch.
    match /emergencies/{sessionId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 4. Cryptographic Live Location Sharing Tokens
    // Public read allowed ONLY via document ID lookup (unpredictable token).
    // NEVER contains user account credentials or medical data.
    match /liveShares/{token} {
      // Anyone with the exact random token can read active coordinates before expiration
      allow read: if resource.data.status == 'active' &&
                     request.time < resource.data.expiresAt;

      // Only the owning authenticated user can create or revoke
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 5. Emergency Facilities Directory (Public verified reference)
    match /facilities/{facilityId} {
      allow read: if true; // Public directory of emergency facilities
      allow write: if isAdmin(); // Only admins can verify or update facility registry
    }

    // 6. Security Audit Logs & System Telemetry
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit log
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
